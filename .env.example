# .env.example
# === PostgreSQL Credentials ===

POSTGRES_DBNAME=db_name
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_HOST=ip
POSTGRES_PORT=port
PG_SCHEMA=schema

# === CUSTOM AI AGENT ===
AGENT=agent

# === GITLAB TOKENS ===
GITLAB_PAT=pat

# === OLLAMA SERVER ===
OLLAMA_IP_ADDRESS=host_ip_address